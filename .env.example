# ==============================================================================
# IDOR Virtual Lab - Environment Configuration
# ==============================================================================

# Application Entry Point
FLASK_APP=app:create_app()
FLASK_ENV=production

# Cryptographic Secret Key (Used for session cookie signing)
# Replace with a high-entropy secret string in real deployments
SECRET_KEY=lab-secret-key-change-this-educational-use-only-98234710293

# Default Educational Operating Mode: 'secure' or 'vulnerable'
# Default launch configuration must always be 'secure' for safe defaults.
LAB_MODE=secure

# Session Cookie Security Configuration
# Set to 'True' when deployed over HTTPS/TLS; leave 'False' for local HTTP development
SESSION_COOKIE_SECURE=False

# SQLite Database Location
DATABASE_PATH=/app/instance/idor_lab.sqlite

# Server Port
PORT=5000
